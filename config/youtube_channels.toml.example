# Example of an AGGREGATOR channel that relays several traders per upload, so the
# default cap would drop most of the payload. Relayed calls only route at all once the
# roster (config/pundit_roster.toml) resolves the originating name to a handle.
# [[channel]]
# id = "UCxxxxxxxxxxxxxxxxxxxxxx"
# name = "example roundup channel"
# handle = "@exampleroundup"
# title_include = []
# title_exclude = ["#shorts"]
# min_duration_s = 180
# lang = "zh"
# item_cap = 12
