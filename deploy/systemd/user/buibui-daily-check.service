[Unit]
# Pushes the daily operator check to Telegram. Type=oneshot, driven by the
# .timer beside this file.
#
# There is no new checking logic here: daily_check.py already covers every
# accumulator (signal-watch, xsmom sync + exec, backup, external-context,
# chart-drops, pundit-priors), and run-job.sh already Telegrams the log tail on
# a non-zero exit. This unit is only the missing PUSH -- previously the check
# ran only when a session remembered to run it.
#
# --exit-on-tier2 is the load-bearing flag. Without it the push would stay
# silent on chart-drops and external-context, which are tier 2 -- i.e. silent on
# exactly the staleness that motivated wanting a nudge at all.
#
# NOTE: docs/plans/ is gitignored, so the ExecStart target is NOT in the repo and
# does not survive a fresh clone. That is a property of where the check lives,
# not of this unit; if the file is ever promoted to tools/, update this path.
Description=buibui daily operator check (Telegram push, tier-1 + tier-2)
Documentation=file:///home/kng/repo/buibui-moon-trader-bot/docs/plans/daily_check.py

[Service]
Type=oneshot
WorkingDirectory=/home/kng/repo/buibui-moon-trader-bot

# Telegram creds must be in the PROCESS env before any Python starts -- the
# app's own load_dotenv() runs too late for run-job.sh's failure path. Leading
# `-` keeps a missing .env from failing the unit.
EnvironmentFile=-/home/kng/repo/buibui-moon-trader-bot/.env

# run-job.sh shells out to `poetry` on its failure path; user units get a
# minimal PATH that would not find linuxbrew's copy, so the alert about a broken
# run would itself break.
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Push the report EVERY day, not only on a red. This is the one job where the
# whole point is that a human reads the output, and failure-only push made a dead
# timer indistinguishable from a healthy day -- see run-job.sh's TELEGRAM_ALWAYS
# comment. It is opt-in per job precisely so the 15-minute signal-watch does not
# inherit it.
Environment=TELEGRAM_ALWAYS=1

# --exit-on-tier2 makes a ROUTINE tier-2 red (chart-drops, freshness) a non-zero
# exit. Without this, run-job.sh reads that as a failed job: heartbeat
# suppressed, healthchecks /fail pinged, push titled FAILED -- so a dead timer
# and a tier-2 nudge looked identical on the phone, which is the exact confusion
# TELEGRAM_ALWAYS above exists to remove.
#
# daily_check.py therefore exits 2 for "tier 1 clear, tier 2 red" and keeps 1 for
# a real tier-1 failure; SOFT_FAIL_RC=2 is how this unit tells the wrapper which
# code means that. It is opt-in per job because a bare 2 is not self-describing
# -- argparse uses it for usage errors, so a blanket rule would mask a genuinely
# broken invocation on the other timers.
Environment=SOFT_FAIL_RC=2

# This report is 86 lines in --telegram layout and both of run-job.sh's trims
# keep the BOTTOM, so the wrapper's default 60 would drop TIER 1 (data
# integrity) and keep TIER 3 (info only) -- the exact inversion of what the
# operator needs to see. The byte cap still bounds the message.
Environment=TG_TAIL_LINES=120

# ...and systemd has to be told the same thing, or the fix only reaches HALF the
# surfaces. run-job.sh preserves the wrapped command's exit code, so a soft day
# leaves the unit exiting 2 -- which systemd reads as a failure, records as
# `status=2/INVALIDARGUMENT`, and parks in `systemctl --user list-units --failed`
# until someone runs `reset-failed`. Measured 2026-08-25 by running this unit
# against a deliberate tier-2 red: the phone said "ok, warnings" while systemd
# said FAILED, which is the exact ambiguity SOFT_FAIL_RC exists to remove, moved
# from one surface to another rather than fixed.
#
# Scoped to 2 on purpose, mirroring SOFT_FAIL_RC above: a blanket success rule
# would swallow a genuine failure, and 2 is the only code this job uses for
# "success, with warnings".
#
# Safe here because nothing keys on the failure state -- this unit declares no
# OnFailure= and no Restart=. Check that again before copying this line to
# another unit; the healthchecks /fail ping is run-job.sh's job and is unaffected,
# since it never consults systemd's view.
SuccessExitStatus=2

# Mandatory once ExecStart is wrapped: without it journald tags output with the
# executable name (run-job.sh), unit attribution is lost, and `journalctl -u`
# reads nothing while the lines sit in the journal under another identity.
SyslogIdentifier=buibui-daily-check

ExecStart=/home/kng/repo/buibui-moon-trader-bot/deploy/run-job.sh daily-check HEALTHCHECKS_URL_DAILY_CHECK -- /home/linuxbrew/.linuxbrew/bin/poetry run python docs/plans/daily_check.py --exit-on-tier2 --telegram

# The check reads analytics.db. On a lock conflict it falls back to a byte-copy
# of a ~320MB file, so the ceiling covers that path rather than the 3s happy one.
TimeoutStartSec=600
Nice=15
IOSchedulingClass=idle
