{
    "globs": [
        "**/*.md",
        "!.git",
        "!.venv",
        "!venv",
        "!node_modules",
        "!web/ui/node_modules",
        "!web/ui/dist",
        // `.claude` stays excluded wholesale, then the committed subtrees are
        // re-included. Do NOT simply drop the exclusion: `.claude/skills/` also
        // holds SYMLINKS to VENDORED external skills (humanizer), which are not
        // ours to lint and would make `make lint-md` permanently red.
        // These globs NO LONGER mirror `.gitignore`, which since 2026-08-19
        // tracks `.claude/` by default. The vendored tree is now COMMITTED but
        // still UNLINTED — deliberate, and the one place the two configs differ:
        // we version an upstream copy without owning its style.
        "!.claude",
        ".claude/skills/*/SKILL.md",
        ".claude/context/*.md",
        ".claude/agents/*.md",
        ".claude/rules/*.md",
        "!.claude/skills/humanizer",
        // `.cache/` is gitignored scratch. It holds whole COPIES of the repo — a
        // clean-tree export for a Trivy scan leaves one behind — so without this
        // the linter walks a second copy of every doc and the pre-commit hook
        // blocks every commit on a file nobody edited. Same intent as `!docs/plans`
        // below: `.gitignore` ignores it, so the linter should too.
        "!.cache",
        "!.agents",
        "!.superpowers",
        "!.github/pull_request_template.md",
        "!docs/plans",
        "!pr-*.md"
    ]
}
