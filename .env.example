# Copy to .env and fill in your values
# Web API token — protects all /api/* endpoints (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
API_TOKEN=your_web_api_token_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Wallet targets for progress bars (optional); comma-separated for multiple
WALLET_TARGET=1000,5000

# --- /ingest-video (optional) ---
# Groq key for whisper-large-v3, used ONLY when a video has no captions —
# most YouTube video is captioned and costs nothing. Free tier is sufficient.
# Leave empty and caption-less videos (nearly all X video) are skipped with a
# health note rather than transcribed.
GROQ_API_KEY=

# /ingest-feed — YouTube Data API v3 key (key-only, no OAuth).
# Restrict to the YouTube Data API in the GCP console.
YOUTUBE_API_KEY=

# --- VPS deploy (systemd timers; see deploy/README.md) ---
# Market data source on the box (binance works from SG/MY — not geo-blocked)
DATA_SOURCE=binance
# XS executor mode for the daily timer: dry_run | testnet | live
EXEC_MODE=dry_run
# Optional fixed sizing capital for a capital-matched testnet A/B
# (set to your real account's equity on testnet; OMIT for live = real equity)
EXEC_CAPITAL=
# Optional extra executor flags, e.g. "--vol-target 0.10"
EXEC_EXTRA_ARGS=
# Binance Futures TESTNET keys (used when EXEC_MODE=testnet; throwaway, no real funds)
BINANCE_TESTNET_API_KEY=your_testnet_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_secret_here
# healthchecks.io dead-man's-switch ping URLs (create one check per job; leave
# empty to disable — but then a silently-missed run won't alert you)
HEALTHCHECKS_URL_SIGNAL=
HEALTHCHECKS_URL_XSMOM=
HEALTHCHECKS_URL_BACKUP=
HEALTHCHECKS_URL_BACKUP_OFFSITE=
HEALTHCHECKS_URL_DAILY_CHECK=
# Off-machine backup target for deploy/backup-offsite.sh, as <remote>:<path>
# (e.g. b2:buibui-backups). Create the remote with `rclone config` FIRST — the
# script exits 1 while this is unset, so an enabled timer complains rather than
# looking green while no off-machine copy exists. Local snapshots alone do not
# survive disk death, and the live outcome rows are not reconstructible.
BUIBUI_BACKUP_REMOTE=
# Extra Claude config roots whose ACCOUNT files deploy/backup-analytics.sh also copies,
# comma-separated. Default: only the root holding this checkout's project tree, because
# a second profile can be another account's and the off-site leg ships snapshots to a
# cloud drive. Each run names any root it is NOT copying. Write ~/ rather than $HOME:
# the Windows task loader exports values literally. e.g. ~/.claude-personal
BUIBUI_BACKUP_EXTRA_CLAUDE_ROOTS=
# Optional ceiling on every sweep, scan and combo-backtest worker pool
# (analytics/workers.py). Blank keeps the defaults: cpu_count-1, or min(4,
# cpu_count-1) for the combo backtests. Set it while another heavy job shares
# the machine. A `--workers` flag still wins where one exists; anything but a
# positive integer raises rather than falling back to the full pool.
BUIBUI_MAX_WORKERS=
