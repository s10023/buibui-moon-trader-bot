venv/
.venv/
__pycache__/
*.pyc
# `.env` alone matches that exact name, so a `.env.bak` left by an edit was
# untracked but fully committable — and this repo flips public.
.env*
!.env.example
.coverage

# Personal config (examples are committed)
config/coins.json
# Personal YouTube follow list for /ingest-feed (example is committed)
config/youtube_channels.toml
# Relay attribution roster for /ingest-video (example is committed)
config/pundit_roster.toml
# X follow roster for /ingest-x discovery (example is committed). Backed up via
# deploy/backup-analytics.sh LEDGERS -- an allowlist, so a new config file here
# is NOT covered until it is added there too.
config/x_authors.toml

# But don't ignore other files in config/
!config/
# .claude/ is COMMITTED on purpose. The hooks, settings and context cards ARE the
# enforcement layer: a reclone that loses them keeps the knowledge and loses the
# DELIVERY, and no CI surface can reach a gitignored hook. Ignore only what is
# per-machine or genuinely secret -- everything else here is tracked by default.
.claude/settings.local.json
# The pre-flip exposure gate's OWN term list. This repo flips public per PR, so
# committing the list would publish exactly what it exists to keep out.
.claude/sensitive-terms.txt
# Claude Code runtime state. Moved here from .git/info/exclude, which no clone carries.
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/routines/.state/
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json
.idea/

# Local planning docs — personal notes, not for public repo
docs/plans/

# DuckDB data files
*.db
*.db.wal
*.db.bak

# Signal daemon runtime state
signal_state.json

# Frontend build artifacts
web/ui/node_modules/
web/ui/dist/
web/ui/.env.local
web/ui/.vite/

# Skills system: the vendored skill and its hash pin are DELIBERATELY COMMITTED.
# A pin nobody can verify is not a pin, and the .claude/skills/* symlink into
# .agents/ is relative, so it resolves on any clone.

# X-post ingest (and research-ingestion) caches
.cache/

# Subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/

# Windows host: deploy/windows/job.sh writes the journal stand-in here (capped per job)
logs/
